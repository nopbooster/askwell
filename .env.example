# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* variables are bundled into the browser: public values only.

# --- Supabase ---
# Public (client + server): RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: acts as service_role and skips RLS.
SUPABASE_SECRET_KEY=

# --- Clerk (auth + billing) ---
# Public (client).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only.
CLERK_SECRET_KEY=
# Server only: verifies Clerk webhooks.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- OpenAI (embeddings) ---
# Server only.
OPENAI_API_KEY=

# --- Anthropic (chat replies) ---
# Server only. The deployed app's key: never use it for development work or tests (tests mock the SDK).
ANTHROPIC_API_KEY=

# --- Arcjet ---
# Server only.
ARCJET_KEY=

# --- PostHog ---
# Public (client + server).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- App ---
# Public (client + server): this deployment's base URL.
NEXT_PUBLIC_APP_URL=
# Server only, read at request time: the widget key for the landing page demo (per environment).
LANDING_WIDGET_KEY=
